# Finzin Backend Environment Variables Template
# Copy this file to .env: copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# NEVER commit .env to version control.

# Server Port
PORT=5000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Supabase Postgres Session Pooler URI (IPv4)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# JWT Secret for signing session & registration tokens (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-32-character-secret-key-goes-here-min-32-chars

# CORS Allowed Client Origins (single URL or comma-separated list; trailing slashes ignored)
CLIENT_ORIGIN=http://localhost:5173,https://finzinnexathon.vercel.app

# ---------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (OTP DELIVERY)
# ---------------------------------------------------------------------
# Select provider: 'brevo' (recommended for Render/cloud over HTTPS) or 'smtp' (local Gmail)
EMAIL_PROVIDER=brevo

# Brevo (Sendinblue) Transactional API (HTTPS Port 443 - Works on Render Free Tier)
# Get your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
MAIL_FROM_EMAIL=your-verified-sender@yourdomain.com
MAIL_FROM_NAME=Finzin Banking

# Legacy / Local Gmail SMTP (Outbound ports 587/465 - Works locally, blocked on Render Free)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---------------------------------------------------------------------
# DEMO & WELCOME SETTINGS
# ---------------------------------------------------------------------
# DEMO_OTP: Fixed 6-digit OTP for local hackathon demo only (strictly forbidden in production)
DEMO_OTP=

# Initial simulated welcome wallet balance in PAISE (500000 paise = Rs 5,000)
WELCOME_CREDIT_PAISE=500000

# ---------------------------------------------------------------------
# AI FINANCIAL COACH
# ---------------------------------------------------------------------
# Groq API for privacy-preserving AI coaching
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
