# Finzin Frontend & Backend Environment Variables Reference

# ---------------------------------------------------------------------
# FRONTEND (.env / Vercel Environment Variables)
# ---------------------------------------------------------------------
# URL of the deployed Express backend
VITE_API_URL=https://finzin-nexathon.onrender.com/api

# ---------------------------------------------------------------------
# BACKEND (backend/.env / Render Environment Variables)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres
JWT_SECRET=your-32-char-random-secret-key-min-32-chars
CLIENT_ORIGIN=https://finzinnexathon.vercel.app,https://finzinnexathon-git-main-linjoel29s-projects.vercel.app

# Email Provider: 'brevo' (HTTPS API for Render) | 'smtp' (Local Gmail SMTP)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
MAIL_FROM_EMAIL=your-verified-sender@domain.com
MAIL_FROM_NAME=Finzin Banking

# Groq AI Coach
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
